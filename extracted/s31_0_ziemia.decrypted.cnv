TIMER1:ENABLED=TRUE
TIMER1:ELAPSE=5000
TIMER1:TICKS=0
TIMER1:ONINIT=DISABLE
TIMER1:ONTICK^1=REKSIOKOLKO

OBJECT=KRE31_0_2
KRE31_0_2:TYPE=SOUND
KRE31_0_2:FILENAME=KRE31_0_2.WAV
KRE31_0_2:PRELOAD=FALSE
KRE31_0_2:FLUSHAFTERPLAYED=FALSE
KRE31_0_2:ONINIT=THISPLAYSOUND
KRE31_0_2:ONFINISHED=UFOLECI

