KEYBOARD:TYPE=KEYBOARD

OBJECT=THISHIDE
THISHIDE:TYPE=BEHAVIOUR
THISHIDE:CODE={THIS^HIDE();}


OBJECT=THISPLAY
THISPLAY:TYPE=BEHAVIOUR
THISPLAY:CODE={THIS^PLAY("PLAY");}


OBJECT=THISPLAYSOUND
THISPLAYSOUND:TYPE=BEHAVIOUR
THISPLAYSOUND:CODE={THIS^PLAY();}


OBJECT=UFOLECI
UFOLECI:TYPE=BEHAVIOUR
UFOLECI:CODE={UFOLE^PLAY("PLAY");}


OBJECT=REKSIOWIDZI
REKSIOWIDZI:TYPE=BEHAVIOUR
REKSIOWIDZI:CODE={REKS31_0_2^PLAY();}


OBJECT=KRETWIDZI
KRETWIDZI:TYPE=BEHAVIOUR
KRETWIDZI:CODE={KRE31_0_3^PLAY();}


OBJECT=RAKIETA1
RAKIETA1:TYPE=BEHAVIOUR
RAKIETA1:CODE={RAKIETA^PLAY("RAKIETA1");TIMER1^ENABLE();}


OBJECT=RAKIETA2
RAKIETA2:TYPE=BEHAVIOUR
RAKIETA2:CODE={RAKIETA^PLAY("RAKIETA2");}


OBJECT=DISABLE
DISABLE:TYPE=BEHAVIOUR
DISABLE:CODE={TIMER1^DISABLE();}


OBJECT=REKSIOKOLKO
REKSIOKOLKO:TYPE=BEHAVIOUR
REKSIOKOLKO:CODE={REKS31_0_3^PLAY();}


OBJECT=KRETWIDZIKOLKO
KRETWIDZIKOLKO:TYPE=BEHAVIOUR
KRETWIDZIKOLKO:CODE={KRE31_0_4^PLAY();}


OBJECT=DOS35_0
DOS35_0:TYPE=BEHAVIOUR
DOS35_0:CODE={PRZYGODA^GOTO("S35_0_WRAKIECIE");}


OBJECT=__INIT__
__INIT__:TYPE=BEHAVIOUR
__INIT__:CODE={VARLEVEL3^SET("S31_0_ZIEMIA");}




