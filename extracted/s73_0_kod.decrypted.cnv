OBJECT=B_RESTART
B_RESTART:TYPE=BEHAVIOUR
B_RESTART:CODE={S_73_0_2^PLAY();}


OBJECT=B_PIERWSZE_WEJSCIE
B_PIERWSZE_WEJSCIE:TYPE=BEHAVIOUR
B_PIERWSZE_WEJSCIE:CODE={S_73_0_1^PLAY();}


OBJECT=__INIT__
__INIT__:TYPE=BEHAVIOUR
__INIT__:CODE={VARLEVEL7^SET("S73_0_KOD");GR_KLAW^ADD("BUT_0","BUT_1","BUT_2","BUT_3","BUT_4","BUT_5","BUT_6","BUT_7","BUT_8","BUT_9","BUT_TAK","BUT_NIE");V_ETAP^SET(VAR_BRAMA);}


OBJECT=B_WPIS
B_WPIS:TYPE=BEHAVIOUR
B_WPIS:CODE={VAR_CYFRA^INC();KALKULATOR1^SHOW();KALKULATOR1^SETFRAME("PLAY",$1);}


OBJECT=B_CYFRA_2
B_CYFRA_2:TYPE=BEHAVIOUR
B_CYFRA_2:CODE={KALKULATOR10^SHOW();KALKULATOR10^SETFRAME("PLAY",KALKULATOR1^GETFRAME());}


OBJECT=B_CYFRA_3
B_CYFRA_3:TYPE=BEHAVIOUR
B_CYFRA_3:CODE={KALKULATOR100^SHOW();KALKULATOR100^SETFRAME("PLAY",KALKULATOR10^GETFRAME());KALKULATOR10^SHOW();KALKULATOR10^SETFRAME("PLAY",KALKULATOR1^GETFRAME());}


OBJECT=B_CYFRA_4
B_CYFRA_4:TYPE=BEHAVIOUR
B_CYFRA_4:CODE={KALKULATOR1000^SHOW();KALKULATOR1000^SETFRAME("PLAY",KALKULATOR100^GETFRAME());KALKULATOR100^SHOW();KALKULATOR100^SETFRAME("PLAY",KALKULATOR10^GETFRAME());KALKULATOR10^SHOW();KALKULATOR10^SETFRAME("PLAY",KALKULATOR1^GETFRAME());}


OBJECT=B_RESET
B_RESET:TYPE=BEHAVIOUR
B_RESET:CODE={KALKULATOR1^HIDE();KALKULATOR10^HIDE();KALKULATOR100^HIDE();KALKULATOR1000^HIDE();KALKULATOR1^SETFRAME("PLAY",10);KALKULATOR10^SETFRAME("PLAY",10);KALKULATOR100^SETFRAME("PLAY",10);KALKULATOR1000^SETFRAME("PLAY",10);VAR_CYFRA^SET(0);GR_KLAW^ENABLE();LAMPKANO^HIDE();LAMPKAYES^SHOW();}


OBJECT=B_CHECK
B_CHECK:TYPE=BEHAVIOUR
B_CHECK:CODE={VAR_KOD^SET([KALKULATOR1000^GETFRAMENAME()+KALKULATOR100^GETFRAMENAME()]);VAR_KOD^ADD([KALKULATOR10^GETFRAMENAME()+KALKULATOR1^GETFRAMENAME()]);@IF("VAR_KOD","!_","2288","BFITMP0","BFITMP1");}


OBJECT=B_WIN
B_WIN:TYPE=BEHAVIOUR
B_WIN:CODE={VAR_BRAMA^SET(3);LAMPKANO^STOP(FALSE);LAMPKANO^HIDE();LAMPKAYES^PLAY("PLAY");S_KOM73_0_2^PLAY();}


OBJECT=B_LOST
B_LOST:TYPE=BEHAVIOUR
B_LOST:CODE={GR_KLAW^DISABLEBUTVISIBLE();LAMPKANO^PLAY("PLAY");LAMPKAYES^HIDE();S_KOM73_0_3^PLAY();}


OBJECT=BFITMP0
BFITMP0:TYPE=BEHAVIOUR
BFITMP0:CODE={B_LOST^RUN();}


OBJECT=BFITMP1
BFITMP1:TYPE=BEHAVIOUR
BFITMP1:CODE={B_WIN^RUN();}




