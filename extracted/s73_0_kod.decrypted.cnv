S_73_0_2:PRELOAD=FALSE
S_73_0_2:FLUSHAFTERPLAYED=FALSE
S_73_0_2:ONFINISHED={GR_KLAW^ENABLE();MENU_KOD^SETASBUTTON(TRUE,TRUE);S_KOM73_0_1^PLAY();}

