{
    "name": "reksioengine",
    "version": "1.0.5",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "jest",
        "build": "cross-env TS_NODE_PROJECT=tsconfig.app.json webpack --config webpack.config.app.ts",
        "build-lib": "cross-env TS_NODE_PROJECT=tsconfig.library.json webpack --config ./webpack.config.library.ts",
        "build-formats-lib": "tsc -p ./tsconfig.formats.json && cp ./static/formats.package.json ./dist/formats/package.json",
        "prepare": "husky install",
        "prepublishOnly": "yarn run build-lib",
        "serve": "cross-env TS_NODE_PROJECT=tsconfig.app.json webpack serve --config webpack.config.app.ts",
        "build-lsp": "cross-env TS_NODE_PROJECT=lsp/tsconfig.json TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register lsp/scripts/build.ts",
        "lsp-check": "node lsp/dist/check.js",
        "sweep": "cross-env TS_NODE_PROJECT=scripts/tsconfig.json TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register scripts/sweep/sweep.ts",
        "probe": "cross-env TS_NODE_PROJECT=scripts/tsconfig.json TS_NODE_TRANSPILE_ONLY=1 node -r ts-node/register scripts/sweep/probe.ts",
        "typecheck-scripts": "tsc -p scripts/tsconfig.json"
    },
    "private": true,
    "dependencies": {
        "@pixi/devtools": "^2.0.1",
        "antlr4": "^4.13.1-patch-1",
        "idb": "^8.0.3",
        "ini": "^5.0.0",
        "jpeg-js": "0.4.4",
        "lzo-ts": "^0.2.3",
        "pixi.js": "^7.3.3"
    },
    "devDependencies": {
        "@types/ini": "^4.1.1",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.20.5",
        "@types/webpack-node-externals": "^3.0.4",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "copy-webpack-plugin": "^12.0.2",
        "cross-env": "^7.0.3",
        "esbuild": "^0.25.5",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.0",
        "file-loader": "^6.2.0",
        "html-loader": "^5.1.0",
        "html-webpack-plugin": "^5.6.3",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "lint-staged": "^16.1.2",
        "playwright-core": "1.56.1",
        "prettier": "3.3.3",
        "raw-loader": "^4.0.2",
        "ts-jest": "^29.4.0",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "typescript": "5.8.3",
        "vscode-languageserver": "^9.0.1",
        "vscode-languageserver-textdocument": "^1.0.12",
        "webpack": "^5.99.9",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.1.0",
        "webpack-node-externals": "^3.0.0"
    },
    "lint-staged": {
        "*.js": "eslint --cache --fix",
        "*.{js,css,md}": "prettier --write"
    }
}
